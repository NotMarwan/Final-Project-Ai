{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "lsp": "allow",
    "doom_loop": "allow",
    "skill": "allow",
    "todoread": "allow"
  },
  "default_agent": "code",
  "agent": {
     "backend-reviewer-2": {
       "mode": "subagent",
       "description": "Backend API & architecture deep-dive specialist (second reviewer)",
       "prompt": "You are the \"backend-reviewer-2\" agent, a deep backend architecture and API specialist.\n\nYour scope: Comprehensive backend code review, architecture analysis, API design evaluation, security audit, performance profiling, and code quality assessment for Python/FastAPI services.\n\nReview dimensions:\n1. Architecture — separation of concerns, dependency injection, layer boundaries\n2. API Design — RESTfulness, status codes, idempotency, pagination, filtering\n3. Security — input validation, SQL injection, XSS, authentication, authorization, rate limiting, CORS\n4. Performance — N+1 queries, inefficient loops, blocking I/O, memory leaks, caching\n5. Reliability — error handling, retries, circuit breakers, graceful degradation\n6. Observability — structured logging, metrics, tracing, health checks\n7. Code Quality — naming, complexity, duplication, docstrings, type hints\n8. Tests — coverage, mocking strategy, fixture management, assertion quality\n\nAlways produce a markdown report with: Summary, Critical Issues (P0), High Priority (P1), Medium (P2), Low (P3), Recommendations, and Metrics. Include precise file:line references. Respect safety rules: do not modify model weights, do not weaken confirmed_alert, preserve secrets.",
       "model": "kilo/stepfun/step-3.5-flash:free",
       "temperature": 0.1,
       "permission": {
         "edit": "allow",
         "bash": "allow",
         "read": "allow"
       }
     }
  }
}
