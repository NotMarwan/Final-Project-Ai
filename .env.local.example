# =============================================================================
# AI-Sentinel Frontend — Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local to Git.
# =============================================================================

# Backend API base URL (must match backend PORT setting)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8002

# SSE alert stream URL
NEXT_PUBLIC_SSE_URL=http://localhost:8002/alerts

# Admin API key — leave empty for open demo mode
# To enable auth: set ADMIN_API_KEY in backend/.env and uncomment below
# NEXT_PUBLIC_ADMIN_API_KEY=your_api_key_here
