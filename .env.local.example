# AI Sentinel Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8002
NEXT_PUBLIC_SSE_URL=http://localhost:8002/alerts
NEXT_PUBLIC_WS_URL=ws://localhost:8002/ws

# Weapon Detector Runtime Tuning
# Backend: 'yolo' (fine-tuned, recommended) or 'torchvision_coco' (legacy COCO)
WEAPON_BACKEND=yolo
# Path to YOLO weights (relative to backend/ or absolute)
WEAPON_WEIGHT_PATH=./weapon_yolo.pt
# Minimum interval between inferences in milliseconds (backpressure)
WEAPON_MIN_INTERVAL_MS=2500
# Latency threshold for flagging 'isRealtime' status
WEAPON_REALTIME_THRESHOLD_MS=500
# Weapon classes to detect (comma-separated)
WEAPON_LABELS=pistol,knife

