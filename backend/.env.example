# =============================================================================
# AI-Sentinel Backend — Environment Variables
# Copy this file to backend/.env and fill in your real values.
# NEVER commit backend/.env to Git.
# =============================================================================

# --- AI Keys ---
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_TEMPERATURE=0.2

# --- Model Paths ---
WEIGHTS_PATH=best_model.pt
WEAPON_WEIGHT_PATH=./weapon_hadi_yolo.pt
WEAPON_BACKEND=yolo
WEAPON_LABELS=pistol,rifle,shotgun,knife,sword,revolver
WEAPON_MIN_INTERVAL_MS=2500

# --- Model Tuning ---
THRESHOLD=0.75
STRIDE=16

# --- Server ---
PORT=8002
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000

# --- Storage ---
DATABASE_PATH=./sentinel.db
THUMBNAILS_DIR=./thumbnails
EVIDENCE_DIR=./evidence_clips

# --- Telegram Alerts ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_MIN_SEVERITY=high
TELEGRAM_TIMEOUT_SECONDS=8.0
TELEGRAM_MIN_ALERT_INTERVAL_SECONDS=60
TELEGRAM_SEND_TEST_ON_STARTUP=false

# --- Security ---
ADMIN_API_KEY=

# --- Camera ---
AI_SENTINEL_ENABLE_CAPTURE_LOOP=true
DEFAULT_CAMERA_ID=CAM-01

# --- Face Intelligence (disabled for demo) ---
FACE_INTEL_ENABLED=false
FACE_DETECTOR_BACKEND=none
