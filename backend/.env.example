# AI Sentinel Backend Configuration
GROQ_API_KEY=your_groq_api_key_here
WEIGHTS_PATH=best_model.pt
THRESHOLD=0.75
STRIDE=16
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*
DATABASE_PATH=./sentinel.db
THUMBNAILS_DIR=./thumbnails
EVIDENCE_DIR=./evidence_clips
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_TIMEOUT_SECONDS=8.0
TELEGRAM_MIN_ALERT_INTERVAL_SECONDS=60
TELEGRAM_SEND_TEST_ON_STARTUP=false
TELEGRAM_MIN_SEVERITY=high
ADMIN_API_KEY=CHANGE_ME_BEFORE_DEMO
AI_SENTINEL_ENABLE_CAPTURE_LOOP=true
CAMERA_PROFILES_PATH=camera_profiles.yml
# Alternative preset focused on Jarir ~200 SAR options:
# CAMERA_PROFILES_PATH=camera_profiles.jarir.yml
DEFAULT_CAMERA_ID=CAM-01
FACE_INTEL_ENABLED=false
FACE_DETECTOR_BACKEND=none
FACE_KNOWN_MATCH_THRESHOLD=0.45
FACE_KNOWN_MIN_CONFIDENCE=0.52
FACE_KNOWN_MATCH_RELAX_FACTOR=1.15
FACE_KNOWN_STRONG_IOU=0.55
FACE_UNKNOWN_MATCH_THRESHOLD=0.30
FACE_UNKNOWN_MATCH_RELAX_FACTOR=1.35
FACE_UNKNOWN_MIN_IOU=0.08
FACE_UNKNOWN_STRONG_IOU=0.55
FACE_UNKNOWN_EMBEDDING_WEIGHT=0.70
FACE_UNKNOWN_IOU_WEIGHT=0.30
FACE_MAX_KNOWN_AGE_FRAMES=45
FACE_MAX_UNKNOWN_AGE_FRAMES=90
FACE_MIN_FACE_SIZE=36
FACE_KNOWN_REGISTRY_PATH=./known_faces_registry.json
FACE_POLICY_OVERRIDES_PATH=./face_policy_overrides.json
FACE_IDENTITY_LABELING_ENABLED=true
FACE_RECOGNITION_AUDIT_ENABLED=true
FACE_RECOGNITION_AUDIT_COOLDOWN_SEC=25
# Fallback sources if camera_profiles.yml is missing or empty:
CAM1_SOURCE=cam1.mp4
CAM2_SOURCE=cam2.mp4
CAM3_SOURCE=cam3.mp4
# OpenRouter / DeepSeek Reporting
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_TEMPERATURE=0.2

# ── Weapon Detector ─────────────────────────────────────────────────────────
WEAPON_BACKEND=yolo
WEAPON_WEIGHT_PATH=./weapon_yolo.pt
WEAPON_LABELS=pistol,knife
